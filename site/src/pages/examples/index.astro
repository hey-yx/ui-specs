---
import Base from '../../layouts/Base.astro'
import FootLine from '../../components/FootLine.astro'
import { CASES } from '../../data/examples'


const description =
  '设计案例成品：给定建站需求，按指南七步定基准规范与设计点，数值全部取自库内原文并逐条标行号。每个案例附 DECISIONS 取值出处与 FINDINGS 缺口记录。'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '设计案例 · UISpecs',
  description,
  inLanguage: 'zh-CN',
  url: new URL('/examples/', Astro.site ?? 'http://localhost:4321').href,
  isPartOf: { '@type': 'WebSite', name: 'UISpecs', url: Astro.site?.href ?? 'http://localhost:4321' },
}
---

<Base title="设计案例 · UISpecs" description={description} jsonLd={jsonLd} path="/examples/">
  <div class="page">
    <div id="main">
      <section class="sec">
        <div class="sec-head">
          <h1 class="sec-title">设计案例</h1>
          <span class="sec-count">{CASES.length} 站</span>
        </div>
        <p class="sec-note">
          用本库的流程走出来的成品：给定建站需求，按指南七步定语境、选基准规范与设计点，数值全部取自库内原文并逐条标行号。成品是单文件 HTML，零外部请求；每个案例的 <code>DECISIONS.md</code> 记每个数值的出处，<code>FINDINGS.md</code> 记基准规范覆盖不到的量怎么派生。
        </p>

        <div class="case-grid">
          {
            CASES.map((c) => (
              <article class="case-card">
                <a class="case-preview" href={`/examples/${c.slug}/index.html`} target="_blank" rel="noopener noreferrer">
                  <img src={`/examples/${c.slug}/preview.png`} alt={`${c.name} 成品预览`} />
                </a>
                <div class="case-body">
                  <h2 class="case-title">
                    <a href={`/examples/${c.slug}/index.html`} target="_blank" rel="noopener noreferrer">{c.name}</a>
                    <span class="case-slug">{c.slug}</span>
                  </h2>
                  <p class="case-tagline">{c.tagline}</p>
                  <dl class="case-meta">
                    <div><dt>主色</dt><dd>{c.accent}</dd></div>
                    <div><dt>结构</dt><dd>{c.structure}</dd></div>
                    <div><dt>版型</dt><dd>{c.layout}</dd></div>
                  </dl>
                  <p class="case-links">
                    <a href={`/examples/${c.slug}/index.html`} target="_blank" rel="noopener noreferrer">打开成品</a>
                    <a href={`/briefs/${c.slug}/`}>需求</a>
                    <a href={`/examples/${c.slug}/decisions/`}>DECISIONS</a>
                    <a href={`/examples/${c.slug}/findings/`}>FINDINGS</a>
                  </p>
                </div>
              </article>
            ))
          }
        </div>

        <p class="sec-note">
          工作流与取数路径见 <a href="/starmap/">指南</a>。
        </p>
      </section>
    </div>

    <FootLine>
      <span>UI 设计规范指南</span>
      <span class="sep" aria-hidden="true">·</span>
      <span><b>{CASES.length}</b> 个设计案例</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>取值出处逐条标文件行号</span>
    </FootLine>
  </div>
</Base>
