---
// 设计地图（设计点选用图）：节点=设计点，每个点连着它牵出的设计场景与该读的文章。
// 数据在 site/src/data/star-points.json（手工维护，构建期校验引用）。
// 星位与连线在构建期算好（纯确定性布局），对话框数据来自构建期序列化的 JSON 岛（#star-data）。
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import FootLine from '../../components/FootLine.astro'
import { buildModel } from '../../lib/model'
import { SECTIONS } from '../../data/sections.ts'
import starData from '../../data/star-points.json'
import { REQUIRED_RULES, requiredRulesFor } from '../../data/guide.ts'
import { buildProjectPoints } from '../../data/project-points.ts'

interface StarPoint {
  id: string
  name: string
  domain: string
  /** 可选：设计地图分区名，覆盖默认的分区标题（项目选型方案用） */
  group?: string
  /** 选型行标记：星图用方块与「选规范」标注，和设计点分开 */
  kind?: 'source'
  select: string
  /** 该行支持的框架与官方组件库，弹窗里单独一块 */
  stacks?: { framework: string; pkg: string }[]
  /** 官方库但不分 React / Vue */
  libs?: { name: string; kind: string }[]
  checks?: { q: string; a: string; cite: string }[]
  tasks: string[]
  articles: string[]
  /** 项目选型行的主题系统截图 */
  shot?: { src: string; caption: string; source: string }
}

const TASKS = starData.tasks as Record<string, { name: string; short: string }>
const MOTION_RULE = REQUIRED_RULES.find((r) => r.pointPrefix)
const MOTION_SCENES = (MOTION_RULE?.tasks ?? []).map((t) => TASKS[t]?.short ?? t).join('、')
const BUILD_RULE_TITLES = REQUIRED_RULES.filter((r) => r.stage === 'build').map((r) => r.title).join('、')
const BUILD_RULE_COUNT = REQUIRED_RULES.filter((r) => r.stage === 'build').length
const REVIEW_RULE_TITLES = REQUIRED_RULES.filter((r) => r.stage === 'review').map((r) => r.title).join('、')

const taskIds = Object.keys(TASKS)
const taskCount = taskIds.length
const PROJECT_POINTS = buildProjectPoints()
const POINTS = [...starData.points, ...PROJECT_POINTS] as StarPoint[]

const specs = await getCollection('specs')
const model = buildModel(specs)
const byFile = new Map(specs.map((s) => [s.data.file, s]))
const sectionTitle = new Map(SECTIONS.map((s) => [s.key, s.title]))

function articleInfo(file: string) {
  const spec = byFile.get(file)
  if (!spec) return null
  return {
    title: spec.data.title,
    publisher: spec.data.publisher,
    sectionTitle: sectionTitle.get(spec.data.section) ?? spec.data.section,
    url: `/a/${file.replace(/\.md$/, '')}/`,
    source: spec.data.source as string,
  }
}

// 自测题出处：content/<分区>/<文件>.md:<行号> → 站内文章链接 + 文件:行号 展示
function citeInfo(cite: string) {
  const m = /^(.+)\.md:(\d+)$/.exec(cite)
  if (!m) return { label: cite, url: '' }
  const path = m[1].replace(/^content\//, '')
  return {
    label: `${path.split('/').pop()}.md:${m[2]}`,
    url: `/a/${path}/`,
  }
}

// 任务轨标签宽度：按字符估宽（CJK 10px、ASCII 6px、空格 3.5px）加 20px 内边距，纯确定性
function tagWidth(label: string) {
  let w = 0
  for (const ch of label) w += /[\u2e80-\u9fff\u3000-\u303f\uf900-\ufaff\uff00-\uffef]/.test(ch) ? 10 : ch === ' ' ? 3.5 : 6
  return Math.round(w + 20)
}

const points = POINTS.map((p) => ({
  ...p,
  checks: (p.checks ?? []).map((c) => ({ ...c, ...citeInfo(c.cite) })),
  articles: p.articles.map(articleInfo).filter((a): a is NonNullable<typeof a> => a !== null),
}))

// 相关点：共享任务的其他点，按共享任务数取前 5
const byTask = new Map<string, string[]>()
for (const p of points) for (const t of p.tasks) byTask.set(t, [...(byTask.get(t) ?? []), p.id])
const related = new Map<string, { id: string; name: string }[]>()
for (const p of points) {
  const shared = new Map<string, number>()
  for (const t of p.tasks) {
    for (const id of byTask.get(t) ?? []) {
      if (id !== p.id) shared.set(id, (shared.get(id) ?? 0) + 1)
    }
  }
  related.set(
    p.id,
    [...shared.entries()]
      .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
      .slice(0, 5)
      .map(([id]) => ({ id, name: points.find((q) => q.id === id)?.name ?? id })),
  )
}

// ── 设计地图布局：按分区聚成分组，右侧任务轨，每个点一条发丝线连到主任务 ──
const CELL_W = 124
const ROW_H = 44
const PER_ROW = 6
const LABEL_H = 30
const GROUP_GAP = 20
const MAIN_X = 20
const RAIL_X = 826

// 节点标签宽度估算（CJK 14px、ASCII 7.4px、空格 4px）：
// 长名分组（项目选型的「企业数据密集（IBM Carbon）」这类）按实际宽度减少每行列数，标签不会压到下一个点
function textWidth(label: string) {
  let w = 0
  for (const ch of label) w += /[\u2e80-\u9fff\u3000-\u303f\uf900-\ufaff\uff00-\uffef]/.test(ch) ? 14 : ch === ' ' ? 4 : 7.4
  return Math.ceil(w)
}
// 圆点右侧 9px 起排，整块宽度给列数计算用
function labelWidth(label: string) {
  return textWidth(label) + 9
}
const MAP_LEFT = MAIN_X + 8
const MAP_W = RAIL_X - 12 - MAP_LEFT

const groups: { key: string; title: string; items: typeof points }[] = []
for (const s of SECTIONS) {
  const items = points.filter((p) => !p.group && p.domain === s.key)
  if (items.length) groups.push({ key: s.key, title: s.title, items })
}
const customGroups = new Map<string, { key: string; title: string; items: typeof points }>()
for (const p of points) {
  if (!p.group) continue
  const key = `group:${p.group}`
  if (!customGroups.has(key)) customGroups.set(key, { key, title: p.group, items: [] })
  customGroups.get(key)!.items.push(p)
}
groups.push(...customGroups.values())

// 左侧分组跟着场景序变换：组内点最常挂的场景（主场景）在新场景序里的位置；同位保持分区配置顺序
const taskRank = new Map(taskIds.map((id, i) => [id, i]))
function dominantRank(items: typeof points) {
  const tally = new Map<string, number>()
  for (const p of items) for (const t of p.tasks) tally.set(t, (tally.get(t) ?? 0) + 1)
  let best = Number.MAX_SAFE_INTEGER
  let bestN = -1
  for (const [t, n] of tally) {
    const r = taskRank.get(t) ?? Number.MAX_SAFE_INTEGER
    if (n > bestN || (n === bestN && r < best)) {
      best = r
      bestN = n
    }
  }
  return best
}
groups.sort((a, b) => dominantRank(a.items) - dominantRank(b.items))

let cursor = 24
const starPos = new Map<string, { x: number; y: number }>()
const groupLabelY: number[] = []
for (const g of groups) {
  const widest = Math.max(...g.items.map((p) => labelWidth(p.name)))
  const cols = Math.max(1, Math.min(PER_ROW, Math.floor(MAP_W / (widest + 18))))
  const cellW = cols >= PER_ROW ? CELL_W : MAP_W / cols
  groupLabelY.push(cursor + 16)
  cursor += LABEL_H
  g.items.forEach((p, i) => {
    starPos.set(p.id, {
      x: MAP_LEFT + (i % cols) * cellW,
      y: cursor + Math.floor(i / cols) * ROW_H + ROW_H / 2,
    })
  })
  cursor += Math.ceil(g.items.length / cols) * ROW_H + GROUP_GAP
}
const H = Math.max(cursor, 520)

const taskY = new Map(taskIds.map((id, j) => [id, 40 + (j * (H - 80)) / (taskIds.length - 1)]))

const stars = points.map((p) => {
  const pos = starPos.get(p.id)!
  return {
    ...p,
    x: pos.x,
    y: pos.y,
    lineY: taskY.get(p.tasks[0]) ?? 40,
    related: related.get(p.id) ?? [],
    taskLabels: p.tasks.map((t) => TASKS[t]?.name ?? t),
  }
})

// 弹窗数据岛：对话框的唯一数据源（构建期从同一份数据序列化；列表删除后详情只在弹窗里）
const dialogData = stars.map((p) => ({
  id: p.id,
  name: p.name,
  kind: p.kind,
  select: p.select,
  stacks: p.stacks,
  libs: p.libs,
  checks: p.checks,
  taskLabels: p.taskLabels,
  articles: p.articles,
  related: p.related,
  shot: p.shot,
  required: requiredRulesFor(p).map((r) => ({ title: r.title, stage: r.stage })),
}))

const description = `设计地图：设计点选用图：${points.length} 个设计点，点开看选点标准、取值示意、牵出的设计场景与该读的文章。`
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '设计地图 · UISpecs',
  description,
  inLanguage: 'zh-CN',
  url: new URL('/starmap/', Astro.site ?? 'http://localhost:4321').href,
  isPartOf: { '@type': 'WebSite', name: 'UISpecs', url: Astro.site?.href ?? 'http://localhost:4321' },
}
---

<Base title="设计地图 · UISpecs" description={description} jsonLd={jsonLd}>
  <div class="page">
    <div id="main">
      <section class="sec">
        <div class="sec-head">
          <h1 class="sec-title">设计地图</h1>
          <span class="sec-count">{points.length} 个设计点</span>
        </div>
        <p class="sec-note">
          点节点看选点标准与该读的文章，每个点连到主场景在右侧任务轨的位置。
        </p>

        <section class="map-block is-flush" aria-label="设计地图">

          <div class="star-legend">
            <span class="star-legend-dot" aria-hidden="true"></span>
            <div>
              <p>
                出稿必选 {BUILD_RULE_COUNT} 类：{BUILD_RULE_TITLES}
                {MOTION_RULE ? `（动效点在${MOTION_SCENES}里找）` : ''}，各至少一个点；验收必选 {REVIEW_RULE_TITLES}。
              </p>
            </div>
          </div>

          <div class="star-filter" role="group" aria-label="按设计场景筛选">
            {
              taskIds.map((id) => (
                <button class="star-chip-btn" type="button" data-task-filter={id} data-task-name={TASKS[id].name} aria-pressed="false">
                  {TASKS[id].short}
                </button>
              ))
            }
          </div>

          <div class="star-map-wrap">
            <svg class="star-map" viewBox={`0 0 1000 ${H}`} role="group" aria-label="设计地图：设计点选用图">
              <g class="star-tasks" aria-hidden="true">
                {
                  taskIds.map((id) => {
                    const y = taskY.get(id) ?? 0
                    return (
                      <Fragment>
                        <rect class="star-task-marker" x={RAIL_X - 3} y={y - 3} width="6" height="6" rx="1.5" />
                        <rect class="star-task-pill" x={RAIL_X + 6} y={y - 10} width={tagWidth(TASKS[id].short)} height="20" rx="6" />
                        <text class="star-task-label" x={RAIL_X + 16} y={y + 3.5}>
                          {TASKS[id].short}
                        </text>
                      </Fragment>
                    )
                  })
                }
              </g>
              {
                groups.map((g, gi) => (
                  <text class="star-domain-label" x={MAIN_X} y={groupLabelY[gi]}>
                    {g.title}（{g.items.length}）{g.items.some((p) => p.kind === 'source') ? ' · 选规范' : ''}
                  </text>
                ))
              }
              <g class="star-lines" aria-hidden="true">
                {
                  stars.map((p) => (
                    <g class="star-line-unit" data-star={p.id} data-tasks={p.tasks.join(' ')}>
                      <line class="star-line" x1={p.x} y1={p.y} x2={RAIL_X - 6} y2={p.lineY} />
                    </g>
                  ))
                }
              </g>
              <g class="star-points">
                {
                  stars.map((p) => (
                    <g class={`star-unit${p.kind === 'source' ? ' is-source' : ''}`} data-tasks={p.tasks.join(' ')}>
                      <a class="star-link" href={`#point-${p.id}`} data-star={p.id} aria-label={`设计点：${p.name}`}>
                        <rect class="star-label-bg" x={p.x + 4} y={p.y - 9} width={textWidth(p.name) + 10} height="18" rx="3" />
                        {p.kind === 'source' ? (
                          <rect class="star-dot" x={p.x - 3.5} y={p.y - 3.5} width="7" height="7" rx="1" />
                        ) : (
                          <circle class="star-dot" cx={p.x} cy={p.y} r="3.5" />
                        )}
                        <text class="star-label" x={p.x + 9} y={p.y + 4}>
                          {p.name}
                        </text>
                      </a>
                    </g>
                  ))
                }
              </g>
            </svg>
          </div>
        </section>
      </section>
    </div>

    <dialog class="star-dialog" id="starDialog" aria-labelledby="starDialogTitle">
      <div class="star-dialog-head">
        <h2 id="starDialogTitle"></h2>
        <button class="star-dialog-close" id="starDialogClose" aria-label="关闭">✕</button>
      </div>
      <div class="star-dialog-body" id="starDialogBody"></div>
    </dialog>

    <FootLine>
      <span>UI 设计规范指南</span>
      <span class="sep" aria-hidden="true">·</span>
      <span><b>{model.total}</b> 篇全文</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>来源为各官方站点与公开文章，原文链接逐篇可查</span>
    </FootLine>
  </div>


  <script is:inline type="application/json" id="star-data" set:html={JSON.stringify(dialogData).replace(/</g, '\\u003c')}></script>
  <script>
    // 点开节点/相关点 → 大对话框；详情渲染自 #star-data 数据岛，无脚本时设计地图只显示点名。
    const dlg = document.getElementById('starDialog') as HTMLDialogElement
    const titleEl = document.getElementById('starDialogTitle') as HTMLElement
    const bodyEl = document.getElementById('starDialogBody') as HTMLElement
    let trigger: HTMLElement | null = null

    interface DialogPoint {
      id: string
      name: string
      kind?: 'source'
      select: string
      stacks?: { framework: string; pkg: string }[]
      libs?: { name: string; kind: string }[]
      checks?: { q: string; a: string; cite: string; label: string; url: string }[]
      taskLabels: string[]
      articles: { title: string; publisher: string; sectionTitle: string; url: string; source: string }[]
      related: { id: string; name: string }[]
      shot?: { src: string; caption: string; source: string }
      required?: { title: string; stage: string }[]
    }
    const starData = new Map<string, DialogPoint>(
      (JSON.parse(document.getElementById('star-data')?.textContent ?? '[]') as DialogPoint[]).map((p) => [p.id, p]),
    )

    function el(tag: string, cls?: string, text?: string): HTMLElement {
      const node = document.createElement(tag)
      if (cls) node.className = cls
      if (text !== undefined) node.textContent = text
      return node
    }

    const STACK_ICONS: Record<string, string> = {
      react:
        '<svg viewBox="-11.5 -10.232 23 20.464" aria-hidden="true"><circle r="2.05" fill="#61dafb"/><g stroke="#61dafb" stroke-width="1" fill="none"><ellipse rx="11" ry="4.2"/><ellipse rx="11" ry="4.2" transform="rotate(60)"/><ellipse rx="11" ry="4.2" transform="rotate(120)"/></g></svg>',
      vue:
        '<svg viewBox="0 0 128 128" aria-hidden="true"><path fill="#42b883" d="M78.8,10L64,35.4L49.2,10H0l64,110l64-110C128,10,78.8,10,78.8,10z"/><path fill="#35495e" d="M78.8,10L64,35.4L49.2,10H25.6L64,76l38.4-66H78.8z"/></svg>',
      tmpl:
        '<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M5 5 2 8l3 3M11 5l3 3-3 3M9.5 3l-3 10"/></svg>',
      wc:
        '<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="1.5" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="8.5" y="8.5" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>',
    }

    function renderDetail(p: DialogPoint): HTMLElement {
      const wrap = el('div', 'star-detail')
      if (p.kind === 'source') wrap.append(el('p', 'star-badge', '基准规范 · 选型方案，不是设计点'))
      if (p.kind === 'source') {
        const rows: { label: string; pkg: string; icon: string }[] = []
        for (const s of p.stacks ?? []) rows.push({ label: s.framework === 'react' ? 'React' : 'Vue', pkg: s.pkg, icon: s.framework })
        for (const l of p.libs ?? []) rows.push({ label: l.kind, pkg: l.name, icon: l.kind.includes('Web Components') ? 'wc' : 'tmpl' })
        if (rows.length) {
          const box = el('div', 'star-stacks')
          box.append(el('p', 'star-stacks-head', '官方组件库与框架'))
          const list = el('ul', 'star-stacks-list')
          for (const r of rows) {
            const li = el('li')
            const icon = el('span', 'star-stack-icon')
            // STACK_ICONS 是本文件内的静态常量，不含外部输入，innerHTML 安全
            icon.innerHTML = STACK_ICONS[r.icon] ?? ''
            li.append(icon, el('span', 'star-stack-fw', r.label), el('code', 'star-stack-pkg', r.pkg))
            list.append(li)
          }
          box.append(list)
          wrap.append(box)
        } else {
          wrap.append(el('p', 'star-stacks-empty', '没有官方组件库，按规范手写 HTML 与 CSS。'))
        }
      }
      if (p.shot) {
        const fig = el('figure', 'star-shot')
        const img = document.createElement('img')
        img.src = p.shot.src
        img.alt = p.shot.caption
        img.loading = 'lazy'
        img.decoding = 'async'
        const open = document.createElement('a')
        open.className = 'star-shot-link'
        open.href = p.shot.src
        open.target = '_blank'
        open.rel = 'noopener'
        open.setAttribute('aria-label', `查看大图：${p.shot.caption}`)
        open.append(img)
        fig.append(open)
        const cap = el('figcaption', 'star-shot-cap', p.shot.caption)
        const a = document.createElement('a')
        a.href = p.shot.source
        a.target = '_blank'
        a.rel = 'noopener'
        a.textContent = '原页'
        cap.append(' ', a)
        fig.append(cap)
        wrap.append(fig)
      }
      const buildReq = p.required?.filter((r) => r.stage === 'build') ?? []
      const reviewReq = p.required?.filter((r) => r.stage === 'review') ?? []
      if (buildReq.length) wrap.append(el('p', 'star-req-note', '必选：' + buildReq.map((r) => r.title).join('、')))
      if (reviewReq.length) wrap.append(el('p', 'star-req-note', '验收：' + reviewReq.map((r) => r.title).join('、')))
      wrap.append(el('p', 'star-blurb', p.select))
      if (p.checks?.length) {
        const box = el('div', 'star-checks')
        box.append(el('p', 'star-checks-head', '自测题 · 出稿前逐题自查，答不出回原文'))
        const list = el('ol', 'star-checks-list')
        for (const c of p.checks) {
          const li = el('li', 'star-check')
          li.append(el('p', 'star-check-q', c.q), el('p', 'star-check-a', c.a))
          const cite = el(c.url ? 'a' : 'span', 'star-check-cite', c.label)
          if (c.url) {
            ;(cite as HTMLAnchorElement).href = c.url
            cite.title = c.cite
          }
          li.append(cite)
          list.append(li)
        }
        box.append(list)
        wrap.append(box)
      }
      const tasks = el('p', 'star-tasks')
      for (const label of p.taskLabels) tasks.append(el('span', 'star-chip', label))
      wrap.append(tasks)
      const arts = el('ul', 'star-articles')
      for (const a of p.articles) {
        const li = el('li')
        const link = el('a', '', a.title) as HTMLAnchorElement
        link.href = a.url
        const meta = el('span', 'star-art-meta', a.publisher + ' · ' + a.sectionTitle)
        const ext = el('a', 'star-ext', '原文') as HTMLAnchorElement
        ext.href = a.source
        ext.target = '_blank'
        ext.rel = 'noopener noreferrer'
        li.append(link, meta, ext)
        arts.append(li)
      }
      wrap.append(arts)
      if (p.related.length) {
        const rel = el('p', 'star-related')
        rel.append('相关点：')
        p.related.forEach((r, i) => {
          if (i > 0) rel.append('、')
          const a = el('a', '', r.name) as HTMLAnchorElement
          a.href = '#point-' + r.id
          a.dataset.star = r.id
          rel.append(a)
        })
        wrap.append(rel)
      }
      return wrap
    }

    function openPoint(id: string) {
      const p = starData.get(id)
      if (!p) return
      titleEl.textContent = p.name
      bodyEl.replaceChildren(renderDetail(p))
      bodyEl.scrollTop = 0
      if (!dlg.open) dlg.showModal()
    }

    // 直接带 #point-<id> 锚点进来时也开弹窗
    const hashId = location.hash.match(/^#point-(.+)$/)?.[1]
    if (hashId) openPoint(hashId)

    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a[data-star]') as HTMLAnchorElement | null
      if (!link || !link.dataset.star) return
      e.preventDefault()
      trigger = link
      openPoint(link.dataset.star)
    })

    document.getElementById('starDialogClose')?.addEventListener('click', () => dlg.close())
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close()
    })
    dlg.addEventListener('close', () => {
      trigger?.focus({ preventScroll: true })
      trigger = null
    })

    // 设计场景筛选：选中场景后设计地图只留相关节点，再点一次取消
    let activeTask = ''
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.star-chip-btn'))
    const lineUnits = Array.from(document.querySelectorAll<SVGElement>('.star-line-unit'))
    function applyFilter() {
      for (const el of document.querySelectorAll<SVGElement>('.star-unit')) {
        const tasks = el.dataset.tasks?.split(' ') ?? []
        const dim = !!activeTask && !tasks.includes(activeTask)
        el.classList.toggle('is-dim', dim)
        // 淡出态同时移出 Tab 序与无障碍树，避免「看不见但能聚焦」
        const link = el.querySelector<SVGElement>('.star-link')
        if (link) {
          link.setAttribute('tabindex', dim ? '-1' : '0')
          link.setAttribute('aria-hidden', String(dim))
        }
      }
      for (const unit of lineUnits) {
        const tasks = unit.dataset.tasks?.split(' ') ?? []
        unit.classList.toggle('is-dim', !!activeTask && !tasks.includes(activeTask))
      }
      for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.taskFilter === activeTask))
    }
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        activeTask = chip.dataset.taskFilter === activeTask ? '' : (chip.dataset.taskFilter ?? '')
        applyFilter()
      })
    }

    for (const link of document.querySelectorAll<SVGElement>('.star-link')) {
      const unit = lineUnits.find((u) => u.dataset.star === link.dataset.star)
      if (!unit) continue
      const on = () => unit.classList.add('is-hot')
      const off = () => unit.classList.remove('is-hot')
      link.addEventListener('pointerenter', on)
      link.addEventListener('pointerleave', off)
      link.addEventListener('focus', on)
      link.addEventListener('blur', off)
    }

  </script>
</Base>
