---
import { getCollection } from 'astro:content'
import '../styles/skin.css'
import '@fontsource-variable/bricolage-grotesque/wght.css'
import Toc from '../components/Toc.astro'
import HeaderSearch from '../components/HeaderSearch.astro'
import Search from '../components/Search.astro'
import { buildModel } from '../lib/model'

export interface Props {
  title: string
  description: string
  /** 规范条目的 canonical 路径（相对站点根），文章页传 /a/<section>/<stem>/ */
  path?: string
  /** JSON-LD 类型：文章页 Article，首页 WebSite */
  jsonLd?: Record<string, unknown>
  /** 是否隐藏搜索索引（文章页不需要重复索引） */
  noindex?: boolean
}

const { title, description, path, jsonLd, noindex = false } = Astro.props
// 常驻左栏：18 个分区与篇数从内容集合算，不写死；当前分区按 URL 判定（分区页 /s/、文章页 /a/）
const specs = await getCollection('specs')
const model = buildModel(specs)
const sectionMatch = Astro.url.pathname.match(/^\/(?:s|a)\/([^/]+)\//)
const currentSection = sectionMatch?.[1]
const canonical = path ? new URL(path, Astro.site ?? 'http://localhost:4321').href : undefined
const themeScript = `try{var t=localStorage.getItem('UISpecs-theme')||localStorage.getItem('Readspec-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}`
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={jsonLd && 'Article' in jsonLd ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="UISpecs" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline set:html={themeScript} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">UISpecs</a>
        <HeaderSearch />
        <nav class="nav-right" aria-label="页面导航">
          <a class="mapLink" href="/examples/">案例</a>
          <a class="mapLink" href="/briefs/">需求</a>
          <a class="mapLink" href="/starmap/">指南</a>
          <a
            class="ghLink"
            href="https://github.com/hey-yx/ui-specs"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="UISpecs 的 GitHub 仓库"
            title="GitHub 仓库"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.72-1.54-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"
              /></svg
            >
          </a>
          <button
            id="tocBtn"
            type="button"
            aria-expanded="false"
            aria-controls="toc"
            aria-label="展开本页目录"
            title="本页目录"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5" /></svg
            >
          </button>
          <button
            id="themeBtn"
            type="button"
            aria-label="主题：自动（跟随系统），点击切换"
            title="主题：自动"
          >
            <svg
              class="auto"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><circle cx="12" cy="12" r="9" /><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none" /></svg
            >
            <svg
              class="moon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg
            >
            <svg
              class="sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              ><circle cx="12" cy="12" r="4" /><path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              /></svg
            >
          </button>
        </nav>
      </div>
    </header>

    <Toc />
    <Search />

    <div class="shell">
      <aside class="side" aria-label="分区导航">
        <div class="side-group">
          <p class="side-label">分区</p>
          <ul class="side-list">
            {
              model.sections.map((section) => (
                <li>
                  <a
                    href={`/s/${section.key}/`}
                    aria-current={currentSection === section.key ? 'page' : undefined}
                  >
                    <span class="side-name">{section.title}</span>
                    <span class="side-n">{section.items.length}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>

      <div class="shell-main">
        <slot />
      </div>

      <nav class="toc-rail" id="toc-rail" aria-label="本页目录" hidden></nav>
    </div>

    <script>
      const root = document.documentElement
      const themeBtn = document.getElementById('themeBtn')

      // header 滚动动效：离开顶部后整条变玻璃层。
      // 搜索框展开只看滚动距离，不看方向：越过 EXPAND_AT 展开，回到 COLLAPSE_AT 以下才收起。
      // 两个阈值之间的区间保持当前状态，滚轮小幅来回不会让搜索框在折叠/展开之间抖动。
      const nav = document.querySelector('.nav') as HTMLElement | null
      if (nav) {
        const EXPAND_AT = 120
        const COLLAPSE_AT = 48
        let expanded = false
        let ticking = false
        const update = () => {
          const y = window.scrollY
          nav.classList.toggle('is-scrolled', y > 8)
          if (!expanded && y > EXPAND_AT) expanded = true
          else if (expanded && y < COLLAPSE_AT) expanded = false
          nav.classList.toggle('is-expanded', expanded)
          ticking = false
        }
        addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true
              requestAnimationFrame(update)
            }
          },
          { passive: true }
        )
        update()
      }

      // 回到顶部：平滑滚到文档顶。锚点 #main 会停在 sticky 导航下方（露出导航盖住正文首行），
      // 所以拦截点击改走 scrollTo(0)，href="#main" 只作无 JS 兜底。
      for (const a of document.querySelectorAll('a.to-top')) {
        a.addEventListener('click', (e) => {
          e.preventDefault()
          window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
        })
      }

      // 主题三态：自动（跟随系统）/ 浅色 / 深色，循环切换
      function themeState() {
        const t = root.dataset.theme
        return t === 'light' || t === 'dark' ? t : 'auto'
      }

      function syncTheme() {
        const state = themeState()
        const label = state === 'auto' ? '自动（跟随系统）' : state === 'light' ? '浅色' : '深色'
        themeBtn?.setAttribute('aria-label', `主题：${label}，点击切换`)
        themeBtn?.setAttribute('title', `主题：${label}`)
      }

      try {
        // 旧键回退：改名前的主题选择不能丢，读不到新键时沿用旧键值
        const saved = localStorage.getItem('UISpecs-theme') ?? localStorage.getItem('Readspec-theme')
        if (saved === 'light' || saved === 'dark') root.dataset.theme = saved
      } catch (e) {}
      syncTheme()

      themeBtn?.addEventListener('click', () => {
        const next = { auto: 'light', light: 'dark', dark: 'auto' }[themeState()]
        if (next === 'auto') delete root.dataset.theme
        else root.dataset.theme = next
        try {
          localStorage.setItem('UISpecs-theme', next)
        } catch (e) {}
        syncTheme()
      })
    </script>
  </body>
</html>
