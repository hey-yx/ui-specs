---
/**
 * header 搜索框。
 *
 * 形态取自 content/patterns/carbon--search-pattern.md 的 active search：
 * 放大镜图标 + 文本输入框 + 输入即出结果的结果面板，并始终显示结果条数；
 * 不给搜索框加可见 label（图标 + placeholder 已足够说明用途）。
 *
 * 与 content/patterns/carbon--global-header.md 一致：搜索是 header 里的独立
 * 区域，窄屏时空间不足改为打开 ⌘K 搜索面板。
 *
 * 折叠/展开由 .nav.is-expanded（向下滚动）驱动，向上滚动收起；
 * 点击放大镜同样能展开。窄屏（<768px）改为打开 ⌘K 面板。
 */
---

<div class="search-zone">
  <div class="search-field" id="searchField">
    <button
      class="search-toggle"
      id="searchToggle"
      type="button"
      aria-expanded="false"
      aria-controls="searchResults"
      aria-label="搜索文章"
      title="搜索文章"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.8-3.8" /></svg
      >
    </button>
    <input
      id="searchInput"
      type="search"
      placeholder="搜索标题、来源、标签…"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="searchResults"
      aria-label="搜索文章"
      tabindex="-1"
    />
    <div class="search-results" id="searchResults" role="listbox" aria-label="搜索结果" hidden></div>
  </div>
</div>

<script>
  import { loadIndex, query } from '../lib/client-search'

  const zone = document.querySelector('.search-zone') as HTMLElement | null
  const toggle = document.getElementById('searchToggle') as HTMLButtonElement | null
  const field = document.getElementById('searchField') as HTMLElement | null
  const input = document.getElementById('searchInput') as HTMLInputElement | null
  const results = document.getElementById('searchResults') as HTMLElement | null
  const nav = document.querySelector('.nav') as HTMLElement | null

  if (zone && toggle && field && input && results) {
    const DESKTOP = window.matchMedia('(min-width: 768px)')
    let hits: Array<{ path: string; title: string; publisher: string; sectionTitle: string }> = []
    let active = -1
    let timer = 0

    function setOpen(open: boolean) {
      zone.classList.toggle('is-open', open)
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false')
      input.tabIndex = open ? 0 : -1
      if (!open) {
        input.value = ''
        results.hidden = true
        results.replaceChildren()
        input.setAttribute('aria-expanded', 'false')
        hits = []
        active = -1
      }
    }

    function openCmkd() {
      window.dispatchEvent(new CustomEvent('ui-specs:open-search'))
    }

    function render(list: typeof hits) {
      hits = list
      active = list.length ? 0 : -1
      results.replaceChildren()

      const head = document.createElement('div')
      head.className = 'search-count'
      head.textContent = list.length ? `${list.length} 条结果` : '没有匹配的文章'
      results.append(head)

      list.forEach((r, i) => {
        const btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'search-hit' + (i === 0 ? ' is-active' : '')
        btn.id = `search-opt-${i}`
        btn.setAttribute('role', 'option')
        btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false')
        const t = document.createElement('span')
        t.className = 't'
        t.textContent = r.title
        const m = document.createElement('span')
        m.className = 'm'
        m.textContent = `${r.publisher} · ${r.sectionTitle}`
        btn.append(t, m)
        btn.addEventListener('click', () => {
          location.href = r.path
        })
        results.append(btn)
      })

      if (list.length) {
        active = 0
        input.setAttribute('aria-activedescendant', 'search-opt-0')
      } else {
        input.removeAttribute('aria-activedescendant')
      }
      results.hidden = false
      input.setAttribute('aria-expanded', 'true')
    }

    async function run() {
      const q = input.value.trim()
      if (!q) {
        results.hidden = true
        results.replaceChildren()
        input.setAttribute('aria-expanded', 'false')
        input.removeAttribute('aria-activedescendant')
        hits = []
        active = -1
        return
      }
      const idx = await loadIndex()
      render(query(idx, q, 8))
    }

    function move(step: number) {
      if (!hits.length) return
      active = (active + step + hits.length) % hits.length
      results.querySelectorAll('.search-hit').forEach((el, i) => {
        el.classList.toggle('is-active', i === active)
        el.setAttribute('aria-selected', i === active ? 'true' : 'false')
      })
      results.querySelectorAll<HTMLElement>('.search-hit')[active]?.scrollIntoView({ block: 'nearest' })
      input.setAttribute('aria-activedescendant', `search-opt-${active}`)
    }

    toggle.addEventListener('click', () => {
      if (!DESKTOP.matches) {
        openCmkd()
        return
      }
      const open = !zone.classList.contains('is-open')
      setOpen(open)
      if (open) input.focus()
    })

    input.addEventListener('input', () => {
      clearTimeout(timer)
      timer = window.setTimeout(run, 120)
    })

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        move(1)
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        move(-1)
      } else if (e.key === 'Enter') {
        e.preventDefault()
        if (hits[active]) location.href = hits[active].path
      } else if (e.key === 'Escape') {
        e.preventDefault()
        setOpen(false)
        toggle.focus()
      }
    })

    // 点外收起
    document.addEventListener('pointerdown', (e) => {
      if (!zone.contains(e.target as Node)) setOpen(false)
    })

    // 滚动状态驱动展开/收起：向下滚动展开，向上滚动收起。
    // 只在 is-expanded 发生变化时同步，避免覆盖用户手动点击开合的结果。
    if (nav) {
      let last = nav.classList.contains('is-expanded')
      new MutationObserver(() => {
        const now = nav.classList.contains('is-expanded')
        if (now === last) return
        last = now
        if (!DESKTOP.matches) {
          setOpen(false)
          return
        }
        setOpen(now)
      }).observe(nav, { attributes: true, attributeFilter: ['class'] })
      if (last) setOpen(true)
    }
  }
</script>
